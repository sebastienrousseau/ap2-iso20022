    given-names: Sebastien
    email: sebastian.rousseau@gmail.com
version: "0.0.5"
date-released: "2026-08-29"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/ap2-iso20022"
url: "https://ap2-iso20022.com"
keywords:
  - ISO 20022
  - AP2
  - x402
  - agent payments
  - pain.001
  - pacs.008
  - Model Context Protocol
  - MCP
  - AI agents
  - payments
